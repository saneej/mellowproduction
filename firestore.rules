rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "msaneejk4@gmail.com" ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }

    // Projects: Public can read published projects, Admins have full access
    match /projects/{projectId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Events: Public can read, Admins write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Media: Public can read, Admins write
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Favorites: Anyone can submit favorites
    match /favorites/{favoriteId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Activity & Download logs
    match /activity_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /download_logs/{downloadId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Admin settings, users, drive accounts, notifications
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_users/{userId} {
      allow read, write: if isAdmin();
    }

    match /drive_accounts/{accountId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }
  }
}
