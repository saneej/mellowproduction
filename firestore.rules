rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Projects collection: Full read & write access
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Events collection: Full read & write access
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Media collection: Full read & write access
    match /media/{mediaId} {
      allow read, write: if true;
    }

    // Favorites collection: Full read & write access
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }

    // Live Client Favorites collection (synced across devices): Full read & write
    match /client_live_favorites/{liveFavoriteId} {
      allow read, write: if true;
    }

    // Activity & Download logs: Full read & write access
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    match /download_logs/{downloadId} {
      allow read, write: if true;
    }

    // Admin settings, users, drive accounts, notifications
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /admin_users/{userId} {
      allow read, write: if true;
    }

    match /drive_accounts/{accountId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
